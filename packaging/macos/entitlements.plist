<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: Snapwright loads no libraries at runtime and needs no JIT. Screen
       capture is granted by the user (Screen Recording), not by an entitlement. -->
  <!-- The hardened runtime blocks the microphone without this; the user still grants it. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
